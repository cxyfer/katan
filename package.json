{
  "name": "catan",
  "version": "0.4.1-rc.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm --filter @catan/web build && pnpm --filter @catan/server build",
    "smoke": "node scripts/smoke.mjs",
    "test:dev": "node --test scripts/dev.test.mjs",
    "verify": "pnpm typecheck && pnpm -r test && pnpm build && pnpm smoke && pnpm test:dev",
    "dev": "node scripts/dev.mjs",
    "start": "node packages/server/dist/server.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
